# Settings that compose.yaml reads (plan 2026-10-27-docker). Copy this file to `.env` (git-ignored)
# and change what you need; each value below is the default used when the setting is absent.

# Host port for the Hiring Desk, published on 127.0.0.1 only (http://localhost:8503).
HIRING_DESK_PORT=8503
# Chat version: v1 (extractive, the default); v2 and v3 also need the `llm` profile.
HR_PORTAL_CHAT_VERSION=v1
# Linux: your user id (`id -u`), so files written into data/datapack/ and logs/ stay yours.
HOST_UID=1000
# Linux: your group id (`id -g`); Docker Desktop on macOS and Windows maps owners itself.
HOST_GID=1000
# Source folder for the `tools` service, mounted read-only at /source: a data/ or a handover copy.
SCREENER_DATA_SOURCE=./data
# Commit recorded in the image label; set it per build: GIT_COMMIT=$(git rev-parse HEAD) docker compose build
GIT_COMMIT=unknown
